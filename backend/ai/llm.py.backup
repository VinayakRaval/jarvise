
import re
import time
import requests
from typing import Dict, List

from config.settings import settings
from utils.logger import get_logger


def repair_response_spacing(text: str) -> str:
    """
    Repair obvious missing spaces in generated responses.

    This function only fixes clear punctuation-spacing issues.
    It does not attempt to split arbitrary joined words because
    doing so can damage valid words, names, and technical terms.
    """
    if not isinstance(text, str):
        return ""

    # Add a space after sentence-ending punctuation when
    # immediately followed by an uppercase letter.
    text = re.sub(r"([.!?])([A-Z])", r"\1 \2", text)

    # Add a space after commas when followed by a non-whitespace
    # character.
    text = re.sub(r",(?=\S)", ", ", text)

    return text.strip()


class LLM:
    """
    JARVIS Local LLM Adapter — Intelligence v4

    Features:
    - Local Ollama integration
    - Persistent HTTP connection reuse
    - Qwen3 thinking disabled for faster responses
    - Configurable generation settings
    - Response latency and token metrics
    - Clear connection, timeout, and server errors
    - Conservative response-spacing repair
    - No cloud API key required
    """

    def __init__(self):
        self.logger = get_logger("JARVIS.LLM")

        self.model = settings.AI_MODEL
        self.base_url = "http://127.0.0.1:11434"

        # Reuse HTTP connections between conversation turns.
        self.session = requests.Session()

        # Keep the model loaded between requests when supported.
        self.keep_alive = "10m"

        # Limit the maximum generated response length.
        self.num_predict = 256

        # Connection timeout and response-read timeout.
        self.timeout = (5, 180)

        self.logger.info(
            "Local LLM initialized | "
            f"model={self.model} | "
            f"keep_alive={self.keep_alive} | "
            f"num_predict={self.num_predict}"
        )

    def generate(
        self,
        instructions: str,
        messages: List[Dict[str, str]],
    ) -> str:
        """
        Generate a response using the local Ollama API.

        Keeps the existing generate(instructions, messages)
        interface so other JARVIS modules remain compatible.
        """
        start_time = time.perf_counter()

        ollama_messages = [
            {
                "role": "system",
                "content": instructions,
            }
        ]

        ollama_messages.extend(messages)

        payload = {
            "model": self.model,
            "messages": ollama_messages,
            "stream": False,
            "think": False,
            "keep_alive": self.keep_alive,
            "options": {
                "temperature": settings.AI_TEMPERATURE,
                "num_predict": self.num_predict,
            },
        }

        try:
            response = self.session.post(
                f"{self.base_url}/api/chat",
                json=payload,
                timeout=self.timeout,
            )

            response.raise_for_status()
            data = response.json()

            message = data.get("message") or {}
            content = message.get("content", "")

            if not isinstance(content, str) or not content.strip():
                raise RuntimeError(
                    "Ollama returned an empty response. "
                    "Check the selected model and Ollama logs."
                )

            # Repair obvious punctuation-spacing issues.
            content = repair_response_spacing(content)

            elapsed = time.perf_counter() - start_time

            # Ollama reports durations in nanoseconds.
            total_duration = data.get("total_duration")
            load_duration = data.get("load_duration")
            prompt_tokens = data.get("prompt_eval_count")
            response_tokens = data.get("eval_count")

            metrics = [
                f"elapsed={elapsed:.2f}s",
            ]

            if isinstance(total_duration, (int, float)):
                metrics.append(
                    f"ollama_total={total_duration / 1e9:.2f}s"
                )

            if isinstance(load_duration, (int, float)):
                metrics.append(
                    f"model_load={load_duration / 1e9:.2f}s"
                )

            if isinstance(prompt_tokens, int):
                metrics.append(
                    f"prompt_tokens={prompt_tokens}"
                )

            if isinstance(response_tokens, int):
                metrics.append(
                    f"response_tokens={response_tokens}"
                )

            self.logger.info(
                "LLM response generated | " + " | ".join(metrics)
            )

            return content

        except requests.exceptions.ConnectionError as exc:
            self.logger.error(
                f"Ollama connection failed: {exc}"
            )
            raise RuntimeError(
                "Cannot connect to Ollama. "
                "Make sure Ollama is running at "
                "http://127.0.0.1:11434."
            ) from exc

        except requests.exceptions.Timeout as exc:
            self.logger.error(
                "Ollama request timed out."
            )
            raise RuntimeError(
                "Ollama took too long to respond. "
                "Check model performance and request length."
            ) from exc

        except requests.exceptions.HTTPError as exc:
            status = (
                exc.response.status_code
                if exc.response is not None
                else "unknown"
            )

            details = (
                exc.response.text[:500]
                if exc.response is not None
                else str(exc)
            )

            self.logger.error(
                f"Ollama HTTP error | status={status} | "
                f"details={details}"
            )

            if status == 404:
                raise RuntimeError(
                    f"Ollama could not find the model "
                    f"'{self.model}'. "
                    "Check available models with: ollama list"
                ) from exc

            raise RuntimeError(
                f"Ollama request failed with HTTP {status}: "
                f"{details}"
            ) from exc

        except requests.exceptions.RequestException as exc:
            self.logger.error(
                f"Ollama request failed: {exc}"
            )
            raise RuntimeError(
                f"Ollama request failed: {exc}"
            ) from exc

        except ValueError as exc:
            self.logger.error(
                f"Invalid JSON returned by Ollama: {exc}"
            )
            raise RuntimeError(
                "Ollama returned an invalid JSON response."
            ) from exc

    def close(self) -> None:
        """Release the persistent HTTP connection pool."""
        self.session.close()
        self.logger.info("LLM HTTP session closed.")
